        private void InitializeStudentDashboard()
        {
            // Student use cases - Added in REVERSE order for DockStyle.Top stacking
            AddMenuButton("📅 Class Schedule", (s, e) => ShowContent("Class Schedule"));
            AddMenuButton("⭐ Grades", (s, e) => ShowContent("Grades"));
            AddMenuButton("💬 Messages", (s, e) => ShowContent("Messages"));
            AddMenuButton("📊 Attendance Record", (s, e) => ShowContent(" Attendance Record"));
            AddMenuButton("📈 Dashboard", (s, e) => ShowContent("Dashboard"));
            AddMenuButton("🔔 Notifications", (s, e) => ShowContent("Notifications"));

            // Show default content
            ShowContent("Welcome to Student Dashboard");
        }

        private void ShowContent(string contentType)
        {
            ClearContentPanel();

            // Create a modern card-based layout
            Panel mainPanel = new Panel();
            mainPanel.Dock = DockStyle.Fill;
            mainPanel.BackColor = Color.FromArgb(240, 240, 240);
            mainPanel.AutoScroll = true;
            mainPanel.Padding = new Padding(20);

            // Title Section
            Panel titlePanel = new Panel();
            titlePanel.Height = 80;
            titlePanel.Dock = DockStyle.Top;
            titlePanel.BackColor = Color.Transparent;

            Label titleLabel = new Label();
            titleLabel.Text = "📋 " + contentType;
            titleLabel.Font = new Font("Microsoft Sans Serif", 24, FontStyle.Bold);
            titleLabel.ForeColor = Color.FromArgb(33, 33, 33);
            titleLabel.AutoSize = true;
            titleLabel.Location = new Point(0, 10);
            titlePanel.Controls.Add(titleLabel);

            Label descLabel = new Label();
            descLabel.Text = GetDescription(contentType);
            descLabel.Font = new Font("Microsoft Sans Serif", 11, FontStyle.Regular);
            descLabel.ForeColor = Color.FromArgb(100, 100, 100);
            descLabel.AutoSize = true;
            descLabel.Location = new Point(0, 50);
            descLabel.MaximumSize = new Size(600, 50);
            titlePanel.Controls.Add(descLabel);

            mainPanel.Controls.Add(titlePanel);

            // Content based on selection
            Panel contentArea = new Panel();
            contentArea.Dock = DockStyle.Top;
            contentArea.BackColor = Color.Transparent;
            contentArea.AutoSize = true;
            contentArea.Padding = new Padding(0, 20, 0, 20);

            switch (contentType)
            {
                case "Dashboard":
                    AddStudentAnalyticsData(contentArea);
                    break;
                case "Notifications":
                    AddNotificationsData(contentArea);
                    break;
                case "View Attendance Record":
                    AddViewAttendanceData(contentArea);
                    break;
                case "Messages":
                    AddMessagingData(contentArea);
                    break;
                case "Grades":
                    AddViewGradesData(contentArea);
                    break;
                case "Class Schedule":
                    AddViewScheduleData(contentArea);
                    break;
                default:
                    AddWelcomeContent(contentArea);
                    break;
            }

            mainPanel.Controls.Add(contentArea);
            contentPanel.Controls.Add(mainPanel);
        }

        private string GetDescription(string contentType)
        {
            switch (contentType)
            {
                case "Dashboard":
                    return "View your academic performance analytics and overall statistics.";
                case "Notifications":
                    return "View important school notifications.";
                case "View Attendance Record":
                    return "Check your attendance records and history.";
                case "Messages":
                    return "Communicate with teachers and classmates.";
                case "Grades":
                    return "View your academic grades and transcripts.";
                case "Class Schedule":
                    return "View your class schedule and assignments.";
                default:
                    return "Welcome to your Student Dashboard.";
            }
        }

