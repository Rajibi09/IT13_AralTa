        private void AddGradesCards(Panel panel)
        {
            string[] items = {
                "📋 Assessment Criteria",
                "✔️ Validate Grades",
                "🔧 Grading Scale",
                "📝 Grade Templates",
                "🔍 Search Grades",
                "📚 Grade by Class",
                "📈 Grade Trends",
                "📄 Grade Report",
                "⚖️ Compare Performance",
                "📊 Grade Statistics"
            };

            int xPos = 0;
            int row = 0;
            int yPos = 0;
            foreach (string item in items)
            {
                Panel card = CreateCard(item, 180, 150);
                card.Location = new Point(xPos, yPos);
                panel.Controls.Add(card);
                xPos += 200;
                row++;
                if (row >= 5)
                {
                    row = 0;
                    xPos = 0;
                    yPos += 170;
                }
            }
            panel.Height = yPos + 180;
        }

