using System;
using System.Windows.Forms;
using System.Drawing;

namespace IT13_project
{
    public class StaffDashboard : BaseDashboard
    {
        public StaffDashboard() : base("Staff")
        {
            InitializeStaffDashboard();
        }

        private void InitializeStaffDashboard()
        {
            // Staff use cases
            AddMenuButton("Manage User Accounts", (s, e) => ShowContent("Manage User Accounts"));
            AddMenuButton("Manage Class", (s, e) => ShowContent("Manage Class"));
            AddMenuButton("Manage Grades & Assessments", (s, e) => ShowContent("Manage Grades & Assessments"));

            // Show default content
            ShowContent("Welcome to Staff Dashboard");
        }

        private void ShowContent(string contentType)
        {
            ClearContentPanel();

            Label titleLabel = new Label();
            titleLabel.Text = contentType;
            titleLabel.Font = new Font("Microsoft Sans Serif", 18, FontStyle.Bold);
            titleLabel.Dock = DockStyle.Top;
            titleLabel.Height = 60;
            titleLabel.Padding = new Padding(20);
            titleLabel.BackColor = Color.FromArgb(76, 175, 80);
            titleLabel.ForeColor = Color.White;
            contentPanel.Controls.Add(titleLabel);

            Panel contentArea = new Panel();
            contentArea.Dock = DockStyle.Fill;
            contentArea.Padding = new Padding(20);

            switch (contentType)
            {
                case "Manage User Accounts":
                    AddUserAccountsContent(contentArea);
                    break;
                case "Manage Class":
                    AddManageClassContent(contentArea);
                    break;
                case "Manage Grades & Assessments":
                    AddGradesContent(contentArea);
                    break;
                default:
                    AddWelcomeContent(contentArea);
                    break;
            }

            contentPanel.Controls.Add(contentArea);
        }

        private void AddUserAccountsContent(Panel panel)
        {
            Label label = new Label();
            label.Text = "User Account Management";
            label.Font = new Font("Microsoft Sans Serif", 12, FontStyle.Bold);
            label.AutoSize = true;
            label.Padding = new Padding(0, 10, 0, 10);
            panel.Controls.Add(label);

            Button[] buttons = {
                CreateButton("Encode New Student"),
                CreateButton("Update Student Basic Information"),
                CreateButton("Assist with Student Registration"),
                CreateButton("Manage Staff Accounts"),
                CreateButton("View User List")
            };

            int yPos = 50;
            foreach (Button btn in buttons)
            {
                btn.Location = new Point(20, yPos);
                btn.Width = 250;
                panel.Controls.Add(btn);
                yPos += 50;
            }
        }

        private void AddManageClassContent(Panel panel)
        {
            Label label = new Label();
            label.Text = "Class Management";
            label.Font = new Font("Microsoft Sans Serif", 12, FontStyle.Bold);
            label.AutoSize = true;
            label.Padding = new Padding(0, 10, 0, 10);
            panel.Controls.Add(label);

            Button[] buttons = {
                CreateButton("Create New Class"),
                CreateButton("Edit Class Information"),
                CreateButton("Assign Students to Class"),
                CreateButton("View Class Schedule"),
                CreateButton("Remove Class")
            };

            int yPos = 50;
            foreach (Button btn in buttons)
            {
                btn.Location = new Point(20, yPos);
                btn.Width = 250;
                panel.Controls.Add(btn);
                yPos += 50;
            }
        }

        private void AddGradesContent(Panel panel)
        {
            Label label = new Label();
            label.Text = "Grades and Assessments";
            label.Font = new Font("Microsoft Sans Serif", 12, FontStyle.Bold);
            label.AutoSize = true;
            label.Padding = new Padding(0, 10, 0, 10);
            panel.Controls.Add(label);

            Button[] buttons = {
                CreateButton("Create Assessment"),
                CreateButton("Input Student Grades"),
                CreateButton("View Grade Reports"),
                CreateButton("Calculate Grade Average"),
                CreateButton("Generate Grading Summary")
            };

            int yPos = 50;
            foreach (Button btn in buttons)
            {
                btn.Location = new Point(20, yPos);
                btn.Width = 250;
                panel.Controls.Add(btn);
                yPos += 50;
            }
        }

        private void AddWelcomeContent(Panel panel)
        {
            Label welcomeLabel = new Label();
            welcomeLabel.Text = "Welcome to Staff Dashboard";
            welcomeLabel.Font = new Font("Microsoft Sans Serif", 14, FontStyle.Bold);
            welcomeLabel.AutoSize = true;
            welcomeLabel.Padding = new Padding(0, 20, 0, 20);
            panel.Controls.Add(welcomeLabel);

            Label descLabel = new Label();
            descLabel.Text = "You can manage user accounts (encode students, update information, assist with registration), manage classes, and manage grades and assessments.";
            descLabel.Font = new Font("Microsoft Sans Serif", 11);
            descLabel.AutoSize = true;
            descLabel.Padding = new Padding(0, 10, 0, 10);
            panel.Controls.Add(descLabel);
        }

        private Button CreateButton(string text)
        {
            Button btn = new Button();
            btn.Text = text;
            btn.Height = 40;
            btn.BackColor = Color.FromArgb(76, 175, 80);
            btn.ForeColor = Color.White;
            btn.Font = new Font("Microsoft Sans Serif", 10);
            btn.Cursor = Cursors.Hand;
            return btn;
        }
    }
}
