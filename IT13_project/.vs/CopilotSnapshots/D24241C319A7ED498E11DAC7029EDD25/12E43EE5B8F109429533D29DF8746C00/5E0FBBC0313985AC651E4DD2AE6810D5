using System;
using System.Windows.Forms;
using System.Drawing;

namespace IT13_project
{
    public class PrincipalDashboard : BaseDashboard
    {
        public PrincipalDashboard() : base("Principal")
        {
            InitializePrincipalDashboard();
        }

        private void InitializePrincipalDashboard()
        {
            // Add menu buttons for Principal use cases from the diagram
            AddMenuButton("Login / Authenticate", (s, e) => ShowContent("Login / Authenticate"));
            AddMenuButton("Manage Class Schedule", (s, e) => ShowContent("Manage Class Schedule"));
            AddMenuButton("Generate Reports", (s, e) => ShowContent("Generate Reports"));
            AddMenuButton("View Analytics Dashboard", (s, e) => ShowContent("View Analytics Dashboard"));
            AddMenuButton("Approve / Review Grades", (s, e) => ShowContent("Approve / Review Grades"));
            AddMenuButton("Monitor Child Progress", (s, e) => ShowContent("Monitor Child Progress"));
            AddMenuButton("Receive Notifications", (s, e) => ShowContent("Receive Notifications"));
            AddMenuButton("Send and Receive Messages", (s, e) => ShowContent("Send and Receive Messages"));

            // Show default content
            ShowContent("Principal Dashboard");
        }

        private void ShowContent(string contentType)
        {
            ClearContentPanel();
            
            Label label = new Label();
            label.Text = contentType;
            label.Font = new Font("Microsoft Sans Serif", 16, FontStyle.Bold);
            label.Dock = DockStyle.Top;
            label.Height = 50;
            label.Padding = new Padding(20);
            contentPanel.Controls.Add(label);

            Label descriptionLabel = new Label();
            descriptionLabel.Text = $"Content for: {contentType}\n\nImplement your business logic here.";
            descriptionLabel.Font = new Font("Microsoft Sans Serif", 12);
            descriptionLabel.Dock = DockStyle.Fill;
            descriptionLabel.Padding = new Padding(20);
            contentPanel.Controls.Add(descriptionLabel);
        }
    }
}
