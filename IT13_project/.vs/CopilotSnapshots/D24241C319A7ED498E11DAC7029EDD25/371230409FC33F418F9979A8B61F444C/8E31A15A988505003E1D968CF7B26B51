        private Panel CreateCard(string title, int width, int height)
        {
            Panel card = new Panel();
            card.Width = width;
            card.Height = height;
            card.BackColor = Color.White;
            card.BorderStyle = BorderStyle.None;
            card.Padding = new Padding(15);
            card.Cursor = Cursors.Hand;

            // Add border effect
            card.Paint += (s, e) =>
            {
                e.Graphics.DrawRectangle(new Pen(Color.FromArgb(220, 220, 220), 1), 0, 0, card.Width - 1, card.Height - 1);
            };

            Label label = new Label();
            label.Text = title;
            label.Font = new Font("Microsoft Sans Serif", 11, FontStyle.Bold);
            label.ForeColor = Color.FromArgb(33, 33, 33);
            label.TextAlign = ContentAlignment.MiddleCenter;
            label.Dock = DockStyle.Fill;
            label.AutoSize = false;
            card.Controls.Add(label);

            // Hover effects
            card.MouseEnter += (s, e) =>
            {
                card.BackColor = Color.FromArgb(255, 152, 0);
                label.ForeColor = Color.White;
            };

            card.MouseLeave += (s, e) =>
            {
                card.BackColor = Color.White;
                label.ForeColor = Color.FromArgb(33, 33, 33);
            };

            return card;
        }

