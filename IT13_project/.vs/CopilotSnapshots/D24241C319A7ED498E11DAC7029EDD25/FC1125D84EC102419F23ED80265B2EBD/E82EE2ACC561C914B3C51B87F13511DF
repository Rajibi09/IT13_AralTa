using System;
using System.Collections.Generic;
using System.Windows.Forms;
using System.Drawing;

namespace IT13_project
{
    public class BaseDashboard : Form
    {
        protected Panel leftPanel;
        protected Panel topPanel;
        protected Panel contentPanel;
        protected Label titleLabel;
        protected Button logoutButton;
        protected Label userRoleLabel;
        protected List<Button> menuButtons = new List<Button>();

        // Parameterless constructor for designer support
        public BaseDashboard()
        {
            this.InitializeBaseDashboard("Dashboard");
        }

        public BaseDashboard(string userRole)
        {
            this.InitializeBaseDashboard(userRole);
        }

        protected virtual void InitializeBaseDashboard(string userRole)
        {
            this.Text = $"AralTa - {userRole} Dashboard";
            this.WindowState = FormWindowState.Maximized;
            this.StartPosition = FormStartPosition.CenterScreen;
            this.Size = new Size(1365, 625);
            this.BackColor = Color.FromArgb(240, 240, 240);

            // Top Panel with Logo and User Info
            topPanel = new Panel();
            topPanel.Dock = DockStyle.Top;
            topPanel.Height = 70;
            topPanel.BackColor = Color.FromArgb(33, 33, 33);
            topPanel.Padding = new Padding(20);

            Label logoLabel = new Label();
            logoLabel.Text = "🎓 AralTa";
            logoLabel.Font = new Font("Microsoft Sans Serif", 18, FontStyle.Bold);
            logoLabel.ForeColor = Color.White;
            logoLabel.AutoSize = true;
            logoLabel.Location = new Point(20, 15);
            topPanel.Controls.Add(logoLabel);

            userRoleLabel = new Label();
            userRoleLabel.Text = $"Role: {userRole}";
            userRoleLabel.Font = new Font("Microsoft Sans Serif", 10);
            userRoleLabel.ForeColor = Color.LightGray;
            userRoleLabel.AutoSize = true;
            userRoleLabel.Location = new Point(topPanel.Width - 200, 25);
            topPanel.Controls.Add(userRoleLabel);

            // Left Navigation Panel
            leftPanel = new Panel();
            leftPanel.Dock = DockStyle.Left;
            leftPanel.Width = 220;
            leftPanel.BackColor = Color.FromArgb(45, 45, 48);
            leftPanel.AutoScroll = true;

            // Title Label in Left Panel
            titleLabel = new Label();
            titleLabel.Text = userRole;
            titleLabel.Font = new Font("Microsoft Sans Serif", 13, FontStyle.Bold);
            titleLabel.ForeColor = Color.White;
            titleLabel.Dock = DockStyle.Top;
            titleLabel.Height = 60;
            titleLabel.TextAlign = ContentAlignment.MiddleCenter;
            titleLabel.BorderStyle = BorderStyle.FixedSingle;
            leftPanel.Controls.Add(titleLabel);

            // Content Panel
            contentPanel = new Panel();
            contentPanel.Dock = DockStyle.Fill;
            contentPanel.BackColor = Color.FromArgb(240, 240, 240);
            contentPanel.AutoScroll = true;

            // Logout Button
            logoutButton = new Button();
            logoutButton.Text = "🚪 Logout";
            logoutButton.Dock = DockStyle.Bottom;
            logoutButton.Height = 50;
            logoutButton.BackColor = Color.FromArgb(220, 53, 69);
            logoutButton.ForeColor = Color.White;
            logoutButton.Font = new Font("Microsoft Sans Serif", 10, FontStyle.Bold);
            logoutButton.FlatStyle = FlatStyle.Flat;
            logoutButton.FlatAppearance.BorderSize = 0;
            logoutButton.Cursor = Cursors.Hand;
            logoutButton.Click += LogoutButton_Click;
            logoutButton.MouseEnter += (s, e) => logoutButton.BackColor = Color.FromArgb(200, 35, 51);
            logoutButton.MouseLeave += (s, e) => logoutButton.BackColor = Color.FromArgb(220, 53, 69);
            leftPanel.Controls.Add(logoutButton);

            // Add controls to form
            this.Controls.Add(contentPanel);
            this.Controls.Add(leftPanel);
            this.Controls.Add(topPanel);
        }

        protected void AddMenuButton(string buttonText, EventHandler clickHandler)
        {
            Button btn = new Button();
            btn.Text = buttonText;
            btn.Width = 220;
            btn.Height = 45;
            btn.Dock = DockStyle.Top;
            btn.BackColor = Color.FromArgb(60, 60, 64);
            btn.ForeColor = Color.White;
            btn.Font = new Font("Microsoft Sans Serif", 10);
            btn.FlatStyle = FlatStyle.Flat;
            btn.FlatAppearance.BorderSize = 0;
            btn.TextAlign = ContentAlignment.MiddleLeft;
            btn.Padding = new Padding(15, 0, 0, 0);
            btn.Cursor = Cursors.Hand;
            btn.Click += clickHandler;
            btn.MouseEnter += (s, e) => btn.BackColor = Color.FromArgb(0, 102, 204);
            btn.MouseLeave += (s, e) => btn.BackColor = Color.FromArgb(60, 60, 64);

            menuButtons.Add(btn);
            leftPanel.Controls.Add(btn);
        }

        protected void ClearContentPanel()
        {
            contentPanel.Controls.Clear();
        }

        protected void AddControlToContent(Control control)
        {
            control.Dock = DockStyle.Fill;
            contentPanel.Controls.Add(control);
        }

        private void LogoutButton_Click(object sender, EventArgs e)
        {
            this.Close();
        }
    }
}
