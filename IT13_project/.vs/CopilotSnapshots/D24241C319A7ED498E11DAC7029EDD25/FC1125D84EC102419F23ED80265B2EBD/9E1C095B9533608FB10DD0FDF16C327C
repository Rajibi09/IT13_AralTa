using System;
using System.Windows.Forms;
using System.Drawing;

namespace IT13_project
{
    public class PrincipalDashboard : BaseDashboard
    {
        public PrincipalDashboard() : base("Principal")
        {
            InitializePrincipalDashboard();
        }

        private void InitializePrincipalDashboard()
        {
            // Principal use cases
            AddMenuButton("View Analytics Dashboard", (s, e) => ShowContent("View Analytics Dashboard"));
            AddMenuButton("Generate Reports", (s, e) => ShowContent("Generate Reports"));
            AddMenuButton("Approve / Review Grades", (s, e) => ShowContent("Approve / Review Grades"));

            // Show default content
            ShowContent("Welcome to Principal Dashboard");
        }

        private void ShowContent(string contentType)
        {
            ClearContentPanel();

            Label titleLabel = new Label();
            titleLabel.Text = contentType;
            titleLabel.Font = new Font("Microsoft Sans Serif", 18, FontStyle.Bold);
            titleLabel.Dock = DockStyle.Top;
            titleLabel.Height = 60;
            titleLabel.Padding = new Padding(20);
            titleLabel.BackColor = Color.FromArgb(0, 150, 136);
            titleLabel.ForeColor = Color.White;
            contentPanel.Controls.Add(titleLabel);

            Panel contentArea = new Panel();
            contentArea.Dock = DockStyle.Fill;
            contentArea.Padding = new Padding(20);

            switch (contentType)
            {
                case "View Analytics Dashboard":
                    AddAnalyticsContent(contentArea);
                    break;
                case "Generate Reports":
                    AddReportsContent(contentArea);
                    break;
                case "Approve / Review Grades":
                    AddApproveGradesContent(contentArea);
                    break;
                default:
                    AddWelcomeContent(contentArea);
                    break;
            }

            contentPanel.Controls.Add(contentArea);
        }

        private void AddAnalyticsContent(Panel panel)
        {
            Label label = new Label();
            label.Text = "Analytics Dashboard";
            label.Font = new Font("Microsoft Sans Serif", 12, FontStyle.Bold);
            label.AutoSize = true;
            label.Padding = new Padding(0, 10, 0, 10);
            panel.Controls.Add(label);

            Button[] buttons = {
                CreateButton("View School Performance Metrics"),
                CreateButton("View Student Performance Analytics"),
                CreateButton("View Attendance Trends"),
                CreateButton("View Grade Distribution"),
                CreateButton("View Enrollment Analytics")
            };

            int yPos = 50;
            foreach (Button btn in buttons)
            {
                btn.Location = new Point(20, yPos);
                btn.Width = 250;
                panel.Controls.Add(btn);
                yPos += 50;
            }
        }

        private void AddReportsContent(Panel panel)
        {
            Label label = new Label();
            label.Text = "Report Generation";
            label.Font = new Font("Microsoft Sans Serif", 12, FontStyle.Bold);
            label.AutoSize = true;
            label.Padding = new Padding(0, 10, 0, 10);
            panel.Controls.Add(label);

            Button[] buttons = {
                CreateButton("Generate Academic Year Report"),
                CreateButton("Generate Student Performance Report"),
                CreateButton("Generate Attendance Report"),
                CreateButton("Generate Staff Performance Report"),
                CreateButton("Export Reports to Excel/PDF")
            };

            int yPos = 50;
            foreach (Button btn in buttons)
            {
                btn.Location = new Point(20, yPos);
                btn.Width = 250;
                panel.Controls.Add(btn);
                yPos += 50;
            }
        }

        private void AddApproveGradesContent(Panel panel)
        {
            Label label = new Label();
            label.Text = "Approve and Review Grades";
            label.Font = new Font("Microsoft Sans Serif", 12, FontStyle.Bold);
            label.AutoSize = true;
            label.Padding = new Padding(0, 10, 0, 10);
            panel.Controls.Add(label);

            Button[] buttons = {
                CreateButton("Review Grade Submissions"),
                CreateButton("Approve Class Grades"),
                CreateButton("Review Grade Discrepancies"),
                CreateButton("Compare Grading Standards"),
                CreateButton("Generate Grade Approval Report")
            };

            int yPos = 50;
            foreach (Button btn in buttons)
            {
                btn.Location = new Point(20, yPos);
                btn.Width = 250;
                panel.Controls.Add(btn);
                yPos += 50;
            }
        }

        private void AddWelcomeContent(Panel panel)
        {
            Label welcomeLabel = new Label();
            welcomeLabel.Text = "Welcome to Principal Dashboard";
            welcomeLabel.Font = new Font("Microsoft Sans Serif", 14, FontStyle.Bold);
            welcomeLabel.AutoSize = true;
            welcomeLabel.Padding = new Padding(0, 20, 0, 20);
            panel.Controls.Add(welcomeLabel);

            Label descLabel = new Label();
            descLabel.Text = "You can view analytics dashboards, generate comprehensive reports, and approve/review grades from all classes.";
            descLabel.Font = new Font("Microsoft Sans Serif", 11);
            descLabel.AutoSize = true;
            descLabel.Padding = new Padding(0, 10, 0, 10);
            panel.Controls.Add(descLabel);
        }

        private Button CreateButton(string text)
        {
            Button btn = new Button();
            btn.Text = text;
            btn.Height = 40;
            btn.BackColor = Color.FromArgb(0, 150, 136);
            btn.ForeColor = Color.White;
            btn.Font = new Font("Microsoft Sans Serif", 10);
            btn.Cursor = Cursors.Hand;
            return btn;
        }
    }
}
