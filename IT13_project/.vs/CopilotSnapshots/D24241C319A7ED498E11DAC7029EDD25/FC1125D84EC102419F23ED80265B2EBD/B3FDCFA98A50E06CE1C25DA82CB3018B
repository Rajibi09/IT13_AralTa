using System;
using System.Windows.Forms;
using System.Drawing;

namespace IT13_project
{
    public class SuperAdminDashboard : BaseDashboard
    {
        public SuperAdminDashboard() : base("Super Admin")
        {
            InitializeSuperAdminDashboard();
        }

        private void InitializeSuperAdminDashboard()
        {
            // Super Admin use cases
            AddMenuButton("System Settings", (s, e) => ShowContent("System Settings"));
            AddMenuButton("Manage User Accounts", (s, e) => ShowContent("Manage User Accounts"));
            AddMenuButton("Generate Reports", (s, e) => ShowContent("Generate Reports"));
            AddMenuButton("Send and Receive Messages", (s, e) => ShowContent("Send and Receive Messages"));
            AddMenuButton("View Analytics Dashboard", (s, e) => ShowContent("View Analytics Dashboard"));

            // Show default content
            ShowContent("Welcome to Super Admin Dashboard");
        }

        private void ShowContent(string contentType)
        {
            ClearContentPanel();

            Label titleLabel = new Label();
            titleLabel.Text = contentType;
            titleLabel.Font = new Font("Microsoft Sans Serif", 18, FontStyle.Bold);
            titleLabel.Dock = DockStyle.Top;
            titleLabel.Height = 60;
            titleLabel.Padding = new Padding(20);
            titleLabel.BackColor = Color.FromArgb(0, 102, 204);
            titleLabel.ForeColor = Color.White;
            contentPanel.Controls.Add(titleLabel);

            Panel contentArea = new Panel();
            contentArea.Dock = DockStyle.Fill;
            contentArea.Padding = new Padding(20);

            switch (contentType)
            {
                case "System Settings":
                    AddSystemSettingsContent(contentArea);
                    break;
                case "Manage User Accounts":
                    AddUserAccountsContent(contentArea);
                    break;
                case "Generate Reports":
                    AddReportsContent(contentArea);
                    break;
                case "Send and Receive Messages":
                    AddMessagingContent(contentArea);
                    break;
                case "View Analytics Dashboard":
                    AddAnalyticsContent(contentArea);
                    break;
                default:
                    AddWelcomeContent(contentArea);
                    break;
            }

            contentPanel.Controls.Add(contentArea);
        }

        private void AddSystemSettingsContent(Panel panel)
        {
            Label label = new Label();
            label.Text = "System Configuration";
            label.Font = new Font("Microsoft Sans Serif", 12, FontStyle.Bold);
            label.AutoSize = true;
            label.Padding = new Padding(0, 10, 0, 10);
            panel.Controls.Add(label);

            Button[] buttons = {
                CreateButton("Configure System Parameters"),
                CreateButton("Manage Email Settings"),
                CreateButton("Set Security Policies"),
                CreateButton("Configure Database"),
                CreateButton("System Backup Settings")
            };

            int yPos = 50;
            foreach (Button btn in buttons)
            {
                btn.Location = new Point(20, yPos);
                btn.Width = 250;
                panel.Controls.Add(btn);
                yPos += 50;
            }
        }

