using System;
using System.Windows.Forms;
using System.Drawing;

namespace IT13_project
{
    public class StudentDashboard : BaseDashboard
    {
        public StudentDashboard() : base("Student")
        {
            InitializeStudentDashboard();
        }

        private void InitializeStudentDashboard()
        {
            // Student use cases
            AddMenuButton("View Attendance Record", (s, e) => ShowContent("View Attendance Record"));
            AddMenuButton("View Class Schedule", (s, e) => ShowContent("View Class Schedule"));
            AddMenuButton("View Grades", (s, e) => ShowContent("View Grades"));
            AddMenuButton("Send and Receive Messages", (s, e) => ShowContent("Send and Receive Messages"));
            AddMenuButton("Receive Notifications", (s, e) => ShowContent("Receive Notifications"));

            // Show default content
            ShowContent("Welcome to Student Dashboard");
        }

        private void ShowContent(string contentType)
        {
            ClearContentPanel();

            Label titleLabel = new Label();
            titleLabel.Text = contentType;
            titleLabel.Font = new Font("Microsoft Sans Serif", 18, FontStyle.Bold);
            titleLabel.Dock = DockStyle.Top;
            titleLabel.Height = 60;
            titleLabel.Padding = new Padding(20);
            titleLabel.BackColor = Color.FromArgb(33, 150, 243);
            titleLabel.ForeColor = Color.White;
            contentPanel.Controls.Add(titleLabel);

            Panel contentArea = new Panel();
            contentArea.Dock = DockStyle.Fill;
            contentArea.Padding = new Padding(20);

            switch (contentType)
            {
                case "View Attendance Record":
                    AddViewAttendanceContent(contentArea);
                    break;
                case "View Class Schedule":
                    AddViewScheduleContent(contentArea);
                    break;
                case "View Grades":
                    AddViewGradesContent(contentArea);
                    break;
                case "Send and Receive Messages":
                    AddMessagingContent(contentArea);
                    break;
                case "Receive Notifications":
                    AddNotificationsContent(contentArea);
                    break;
                default:
                    AddWelcomeContent(contentArea);
                    break;
            }

            contentPanel.Controls.Add(contentArea);
        }

        private void AddViewAttendanceContent(Panel panel)
        {
            Label label = new Label();
            label.Text = "My Attendance Record";
            label.Font = new Font("Microsoft Sans Serif", 12, FontStyle.Bold);
            label.AutoSize = true;
            label.Padding = new Padding(0, 10, 0, 10);
            panel.Controls.Add(label);

            Button[] buttons = {
                CreateButton("View Monthly Attendance"),
                CreateButton("View Semester Attendance"),
                CreateButton("View Attendance Percentage"),
                CreateButton("Download Attendance Report"),
                CreateButton("View Absences & Lates")
            };

            int yPos = 50;
            foreach (Button btn in buttons)
            {
                btn.Location = new Point(20, yPos);
                btn.Width = 250;
                panel.Controls.Add(btn);
                yPos += 50;
            }
        }

