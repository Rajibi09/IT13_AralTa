        private void InitializeSuperAdminDashboard()
        {
            // Super Admin use cases - Added in REVERSE order due to DockStyle.Top stacking
            AddMenuButton("🏷️ MSME Config", (s, e) => ShowContent("MSME Configuration"));
            AddMenuButton("⚙️ Settings", (s, e) => ShowContent("System Settings"));
            AddMenuButton("📈 Reports", (s, e) => ShowContent("Generate Reports"));
            AddMenuButton("💬 Messages", (s, e) => ShowContent("Send and Receive Messages"));
            AddMenuButton("👥 Accounts", (s, e) => ShowContent("Manage User Accounts"));
            AddMenuButton("📊 Dashboard", (s, e) => ShowContent("View Analytics Dashboard"));
            // Show default content
            ShowContent("Super Admin Area");
        }

        private void ShowContent(string contentType)
        {
            ClearContentPanel();

            // Create a modern card-based layout
            Panel mainPanel = new Panel();
            mainPanel.Dock = DockStyle.Fill;
            mainPanel.BackColor = Color.FromArgb(240, 240, 240);
            mainPanel.AutoScroll = true;
            mainPanel.Padding = new Padding(20);

            // Title Section - only show on default/welcome screen
            if (contentType == "Super Admin Area")
            {
                Panel titlePanel = new Panel();
                titlePanel.Height = 80;
                titlePanel.Dock = DockStyle.Top;
                titlePanel.BackColor = Color.Transparent;

                Label titleLabel = new Label();
                titleLabel.Text = "📋 " + contentType;
                titleLabel.Font = new Font("Microsoft Sans Serif", 24, FontStyle.Bold);
                titleLabel.ForeColor = Color.FromArgb(33, 33, 33);
                titleLabel.AutoSize = true;
                titleLabel.Location = new Point(0, 10);
                titlePanel.Controls.Add(titleLabel);

                Label descLabel = new Label();
                descLabel.Text = GetDescription(contentType);
                descLabel.Font = new Font("Microsoft Sans Serif", 11, FontStyle.Regular);
                descLabel.ForeColor = Color.FromArgb(100, 100, 100);
                descLabel.AutoSize = true;
                descLabel.Location = new Point(0, 50);
                descLabel.MaximumSize = new Size(600, 50);
                titlePanel.Controls.Add(descLabel);

                mainPanel.Controls.Add(titlePanel);
            }

            // Content Cards
            Panel cardsPanel = new Panel();
            cardsPanel.Dock = DockStyle.Top;
            cardsPanel.BackColor = Color.Transparent;
            cardsPanel.AutoSize = true;
            cardsPanel.Padding = new Padding(0, 20, 0, 0);

            switch (contentType)
            {
                case "View Analytics Dashboard":
                    AddAnalyticsCards(cardsPanel);
                    break;
                case "Manage User Accounts":
                    AddUserAccountsCards(cardsPanel);
                    break;
                case "Send and Receive Messages":
                    AddMessagingCards(cardsPanel);
                    break;
                case "Generate Reports":
                    AddReportsCards(cardsPanel);
                    break;
                case "System Settings":
                    AddSystemSettingsCards(cardsPanel);
                    break;
                case "MSME Configuration":
                    AddMSMEConfigurationCards(cardsPanel);
                    break;
                default:
                    AddWelcomeCards(cardsPanel);
                    break;
            }

            mainPanel.Controls.Add(cardsPanel);
            contentPanel.Controls.Add(mainPanel);
        }

        private string GetDescription(string contentType)
        {
            switch (contentType)
            {
                case "View Analytics Dashboard":
                    return "View system-wide performance and activity analytics.";
                case "Manage User Accounts":
                    return "Create, edit, and manage all user accounts with full control.";
                case "Send and Receive Messages":
                    return "Send system messages and manage messaging templates.";
                case "Generate Reports":
                    return "Generate comprehensive system and activity reports.";
                case "System Settings":
                    return "Configure system parameters, database, and security settings.";
                case "MSME Configuration":
                    return "Manage MSME tiers, pricing, and feature access levels.";
                default:
                    return "Welcome to your Super Admin Dashboard. Full system control available.";
            }
        }

        private void AddMSMEConfigurationCards(Panel panel)
        {
            // Header
            Panel headerPanel = CreateHeaderPanel("🏷️ MSME Configuration", "Manage MSME tiers, pricing, and feature access levels.", Color.FromArgb(0, 102, 204));
            panel.Controls.Add(headerPanel);

            string[] items = {
                "⚙️ Manage Tiers",
                "💲 Pricing Settings",
                "🔓 Feature Access",
                "📦 Package Bundles",
                "📈 Usage Limits"
            };

            int xPos = 0;
            Panel cardRow = new Panel();
            cardRow.Location = new Point(0, 90);
            cardRow.Size = new Size(1000, 180);
            foreach (string item in items)
            {
                Panel card = CreateCard(item, 180, 150);
                card.Location = new Point(xPos, 0);
                // Add click handlers for MSME management actions (placeholders)
                card.Click += (s, e) =>
                {
                    MessageBox.Show("Action: " + item, "MSME Configuration", MessageBoxButtons.OK, MessageBoxIcon.Information);
                };
                // Ensure label inside card also triggers click
                if (card.Controls.Count > 0 && card.Controls[0] is Label lbl)
                {
                    lbl.Click += (s, e) => { card.OnClick(e); };
                }
                cardRow.Controls.Add(card);
                xPos += 200;
            }
            panel.Controls.Add(cardRow);
            panel.Height = 290;
        }

